# Non-secret runtime parameters. Set production values with the Firebase CLI.
STAFF_INVITE_EMAIL_FROM=SmallBizz <invites@example.com>
STAFF_INVITE_SUPPORT_EMAIL=support@example.com
STAFF_INVITE_APP_URL=http://localhost:5173

# STAFF_INVITE_EMAIL_API_KEY is a Secret Manager secret, not an environment variable.
# The Functions emulator uses a no-delivery adapter and never contacts the provider.
