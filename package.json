{
  "name": "smallbiz-manager",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "test": "npm run test:unit",
    "test:unit": "esbuild tests/all.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/all.test.mjs && node --test .test-dist/all.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-smallbizz \"tsx --test tests/firestore.rules.test.ts\"",
    "test:functions": "npm --prefix functions test",
    "test:integration": "npm --prefix functions run build && node --test functions/lib/restaurantIntegration.test.js",
    "test:all": "npm run test:unit && npm run test:functions && npm run test:rules && npm run test:integration",
    "test:e2e": "npm --prefix functions run build && playwright test",
    "e2e:serve": "firebase emulators:exec --only auth,firestore,functions --project demo-smallbizz \"vite --host 127.0.0.1 --port 4173\"",
    "emulators": "firebase emulators:start --only firestore,auth,functions --project demo-smallbizz",
    "migrate": "tsx scripts/migrateFirestore.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.3",
    "lucide-react": "^0.263.0",
    "recharts": "^2.5.0",
    "clsx": "^1.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "^5.5.0",
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "tailwindcss": "^3.4.7",
    "postcss": "^8.4.36",
    "autoprefixer": "^10.4.14",
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase-admin": "13.10.0",
    "firebase-tools": "15.29.0",
    "tsx": "4.23.13"
  }
}
