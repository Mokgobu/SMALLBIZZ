# Browser-safe Firebase web configuration. These identify the Firebase project but
# are not backend secrets. For local emulator work, copy this file to
# .env.development.local so production builds cannot inherit emulator identifiers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Required for production builds. This reCAPTCHA Enterprise site key is public;
# App Check is enforced on privileged callable Functions in production.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Local development only. Never enable this in a production environment.
VITE_USE_FIREBASE_EMULATORS=false

# Backend-only values such as STAFF_INVITE_EMAIL_API_KEY are configured with
# Firebase Functions secrets/parameters and must never use a VITE_ prefix.
